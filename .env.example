# =============================================================================
# Heritage Short — copy to .env and fill values. NEVER commit .env or paste keys.
# Guide: docs/SETUP.md
# =============================================================================
#
# VARIABLE               | FILM JOB                    | REQUIRED WHEN
# -----------------------|-----------------------------|---------------------------
# USE_MOCK_PROVIDERS     | All stages (fake vs real)   | Always (start: true)
# GEMINI_API_KEY         | Story + narration voice     | Radio cut / real TTS
# TTS_PROVIDER           | mock or gemini              | gemini for real voice
# GEMINI_MODEL           | (optional) model name      | Optional
# CLOUDFLARE_ACCOUNT_ID  | Still images (FLUX)         | Real keyframes
# CLOUDFLARE_API_TOKEN   | Still images (FLUX)         | Real keyframes
# FLUX_API_KEY           | Optional alias for token    | Optional
# KAGGLE_API_TOKEN       | GPU on kaggle.com           | Wan/ACE in notebooks
# WAN_API_URL            | Auto video API              | Rare (usually empty)
# ACE_STEP_URL           | Auto music API              | Rare (usually empty)
# =============================================================================

USE_MOCK_PROVIDERS=true

GEMINI_API_KEY=
GEMINI_MODEL=
TTS_PROVIDER=mock

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FLUX_API_KEY=

KAGGLE_API_TOKEN=

WAN_API_URL=
ACE_STEP_URL=

# Optional paths
# STORYBOARD_PATH=storyboard.json
# OUTPUTS_DIR=outputs
# FFMPEG_PATH=ffmpeg
# END_CARD_IMAGE=/path/to/your/end_card.png
# MUSIC_FILE=/path/to/ace_step_background.wav