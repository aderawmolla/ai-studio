# Copy this file to .env and fill in values. Never commit .env.
# Full setup guide: docs/SETUP_KEYS.md

# --- Mode ---
# true  = no API keys (placeholder images/audio) — good for testing the pipeline
# false = use real providers where implemented
USE_MOCK_PROVIDERS=true

# --- Google Gemini (story, storyboard help, narration TTS) ---
# Get: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Cloudflare Workers AI (FLUX keyframes) ---
# Get: https://dash.cloudflare.com → Workers & Pages → Workers AI → API token
# Often you need account id + token (see SETUP_KEYS.md)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Legacy single field used by some code paths:
FLUX_API_KEY=

# --- Wan 2.2 image-to-video (Kaggle / your server) ---
# Optional until you expose a notebook or local API
WAN_API_URL=

# --- ACE-Step music (Kaggle / Colab / local) ---
ACE_STEP_URL=

# --- Narration ---
# mock | gemini  (gemini needs USE_MOCK_PROVIDERS=false + GEMINI_API_KEY)
TTS_PROVIDER=mock

# --- Optional paths ---
# STORYBOARD_PATH=storyboard.json
# OUTPUTS_DIR=outputs
# FFMPEG_PATH=ffmpeg