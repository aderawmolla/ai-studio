{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritage-short.local/storyboard.schema.json",
  "title": "Heritage Short Storyboard",
  "type": "object",
  "required": ["project", "scenes", "shots", "references"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "topic",
        "location",
        "target_audience",
        "film_language",
        "narration_language",
        "visual_style",
        "target_duration_seconds",
        "aspect_ratios"
      ],
      "additionalProperties": false,
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "target_audience": { "type": "string" },
        "film_language": { "type": "string" },
        "narration_language": { "type": "string" },
        "visual_style": { "type": "string" },
        "target_duration_seconds": { "type": "number", "minimum": 60, "maximum": 90 },
        "aspect_ratios": {
          "type": "array",
          "items": { "type": "string", "enum": ["9:16", "16:9"] },
          "minItems": 1
        },
        "creative_direction": { "type": "string" },
        "music_prompt": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "version": { "type": "integer" },
        "historical_notes": { "type": "string" },
        "creative_notes": { "type": "string" }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "type", "description"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["character", "location", "object"] },
          "description": { "type": "string" },
          "image_path": { "type": ["string", "null"] },
          "generation_status": { "type": "string" }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "title", "order"],
        "properties": {
          "scene_id": { "type": "string" },
          "title": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "scene_id",
          "shot_order",
          "duration_seconds",
          "narration_text",
          "visual_description",
          "image_prompt",
          "video_prompt",
          "camera_movement",
          "subtitle_text_en"
        ],
        "properties": {
          "shot_id": { "type": "string" },
          "scene_id": { "type": "string" },
          "shot_order": { "type": "integer", "minimum": 0 },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "narration_text": { "type": "string" },
          "visual_description": { "type": "string" },
          "image_prompt": { "type": "string" },
          "video_prompt": { "type": "string" },
          "camera_movement": { "type": "string" },
          "character_refs": { "type": "array", "items": { "type": "string" } },
          "location_refs": { "type": "array", "items": { "type": "string" } },
          "subtitle_text_en": { "type": "string" },
          "keyframe_path": { "type": ["string", "null"] },
          "clip_path": { "type": ["string", "null"] },
          "narration_path": { "type": ["string", "null"] },
          "generation_status": {
            "type": "object",
            "properties": {
              "keyframe": { "type": "string" },
              "video": { "type": "string" },
              "narration": { "type": "string" }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "music_path": { "type": ["string", "null"] },
        "full_narration_path": { "type": ["string", "null"] },
        "subtitles_path": { "type": ["string", "null"] }
      }
    },
    "final": {
      "type": "object",
      "properties": {
        "vertical_path": { "type": ["string", "null"] },
        "horizontal_path": { "type": ["string", "null"] },
        "end_card_path": { "type": ["string", "null"] }
      }
    }
  }
}